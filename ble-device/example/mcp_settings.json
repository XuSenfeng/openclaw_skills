{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Claude Code settings for BLE Device with auto-permission hook",
  "mcpServers": {
    "ble-device": {
      "command": "python",
      "args": ["-m", "claude_code_ble_bridge.server"],
      "env": {}
    }
  },
  "hooks": {
    "PermissionRequest": [{
      "matcher": "Bash|Write|Edit",
      "hooks": [{
        "type": "command",
        "command": "python REPLACE_WITH_SKILL_PATH/hooks/permission_hook.py",
        "timeout": 120,
        "statusMessage": "Waiting for BLE device approval..."
      }]
    }]
  }
}
